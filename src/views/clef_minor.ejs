<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Clef & Minor Keys - Music Theory App</title>
    <script src="https://cdn.jsdelivr.net/npm/vexflow@4.2.2/build/cjs/vexflow.js"></script>
    <style>
        body { font-family: sans-serif; max-width: 800px; margin: 0 auto; padding: 20px; }
        .card { border: 1px solid #ddd; padding: 20px; border-radius: 8px; margin-bottom: 20px; }
        .btn { padding: 10px 20px; background-color: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer; text-decoration: none; display: inline-block; }
        .btn:hover { background-color: #0056b3; }
        .btn-secondary { background-color: #6c757d; }
        .btn-secondary:hover { background-color: #5a6268; }
        .controls { display: flex; gap: 20px; align-items: center; margin-bottom: 20px; }
        .vexflow-canvas { width: 100%; overflow-x: auto; display: flex; justify-content: center; margin: 20px 0; border: 1px solid #eee; padding: 10px; }
        .options-container { display: flex; flex-direction: column; gap: 20px; margin-bottom: 20px; }
        .radio-group { display: flex; flex-direction: column; gap: 10px; }
        .radio-label { display: flex; align-items: center; gap: 10px; cursor: pointer; }
        .result { padding: 15px; margin-top: 20px; border-radius: 4px; }
        .success { background-color: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
        .error { background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }
    </style>
</head>
<body>
    <%- include('partials/header', { title: 'Clef & Minor Keys', description: 'Identify the clef and minor key from the musical score.' }) %>

    <div class="card">
        <form action="/clef_minor/generate" method="POST" class="controls">
            <label>
                Difficulty:
                <select name="level" onchange="this.form.submit()">
                    <option value="easy" <%= data.level === 'easy' ? 'selected' : '' %>>Easy</option>
                    <option value="intermediate" <%= data.level === 'intermediate' ? 'selected' : '' %>>Intermediate</option>
                    <option value="hard" <%= data.level === 'hard' ? 'selected' : '' %>>Hard</option>
                </select>
            </label>
            <button type="submit" class="btn">Generate New Question</button>
        </form>

        <% if (data.question) { %>
            <div class="question-area">
                <div id="score-canvas" class="vexflow-canvas"></div>
                
                <form action="/clef_minor/check" method="POST">
                    <div class="options-container">
                        <div>
                            <h3>Select the Key:</h3>
                            <div class="radio-group">
                                <% 
                                if (data.question.userOptions) {
                                    data.question.userOptions.forEach(option => { 
                                %>
                                    <label class="radio-label">
                                        <input type="radio" name="option" value="<%= option %>" required
                                            <%= data.selectedOption === option ? 'checked' : '' %>>
                                        <%= option %>
                                    </label>
                                <% 
                                    });
                                } 
                                %>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-secondary" <%= feedback ? 'disabled' : '' %>>Check Answer</button>
                </form>

                <% if (feedback) { %>
                    <div class="result <%= feedback.correct ? 'success' : 'error' %>">
                        <%= feedback.message %>
                    </div>
                <% } %>
            </div>

            <script id="notes-data" type="application/json">
                <%- JSON.stringify(data.vexFlowData.notes) %>
            </script>
            <script>
                const { Renderer, Stave, StaveNote, Accidental, Formatter } = Vex.Flow;
                
                // Data from server
                const notesData = JSON.parse(document.getElementById('notes-data').textContent);
                const clef = "<%= data.vexFlowData.clef %>";
                
                const container = document.getElementById("score-canvas");
                const width = Math.max(500, notesData.length * 40 + 50);
                const height = 150;
                
                const renderer = new Renderer(container, Renderer.Backends.SVG);
                renderer.resize(width, height);
                const context = renderer.getContext();
                
                const stave = new Stave(10, 20, width - 20);
                stave.addClef(clef);
                stave.setContext(context).draw();
                
                const notes = notesData.map(noteKey => {
                    if (!noteKey) return null;
                    const [key] = noteKey.split('/');
                    const note = new StaveNote({
                        clef: clef,
                        keys: [noteKey],
                        duration: "q",
                        auto_stem: true
                    });
                    
                    if (key.includes('##')) {
                        note.addModifier(new Accidental("##"));
                    } else if (key.includes('#')) {
                        note.addModifier(new Accidental("#"));
                    } else if (key.includes('bb')) {
                        note.addModifier(new Accidental("bb"));
                    } else if (key.includes('b')) {
                        note.addModifier(new Accidental("b"));
                    }
                    return note;
                }).filter(n => n !== null);
                
                if (notes.length > 0) {
                    Formatter.FormatAndDraw(context, stave, notes);
                }
            </script>
        <% } else { %>
            <p>Click "Generate New Question" to start!</p>
        <% } %>
    </div>
    <%- include('partials/ai_chat') %>
</body>
</html>
