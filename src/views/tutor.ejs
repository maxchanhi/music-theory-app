<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  <script src="/scripts/vexflow/vexflow.js"></script>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(160deg, #fff4d6 0%, #ffe0f0 35%, #ddf8ff 72%, #e4ffef 100%);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    .header {
      background: #1f2b4a;
      color: white;
      padding: 16px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .header h1 { font-size: 20px; display: flex; align-items: center; gap: 8px; }
    .header .user-info { font-size: 13px; opacity: 0.8; }
    .mode-toggle {
      display: flex; gap: 4px; background: #2a3a5a; border-radius: 8px; padding: 2px;
    }
    .mode-toggle button {
      padding: 6px 14px; border: none; border-radius: 6px; cursor: pointer;
      font-size: 13px; background: transparent; color: rgba(255,255,255,0.6); transition: all 0.2s;
    }
    .mode-toggle button.active { background: #8e44ad; color: white; }
    .container {
      flex: 1; display: flex; flex-direction: column; max-width: 800px;
      margin: 0 auto; width: 100%; padding: 16px;
    }
    .chat-area {
      flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column;
      gap: 12px; background: rgba(255,255,255,0.85); border-radius: 16px;
      border: 2px solid #e5e9ff; margin-bottom: 12px; min-height: 400px;
    }
    .message {
      max-width: 85%; padding: 12px 16px; border-radius: 14px;
      line-height: 1.5; font-size: 15px; word-wrap: break-word; animation: fadeIn 0.3s;
    }
    .message.user {
      align-self: flex-end; background: #8e44ad; color: white;
      border-bottom-right-radius: 4px;
    }
    .message.tutor {
      align-self: flex-start; background: white; color: #1f2b4a;
      border: 1px solid #e0e0e0; border-bottom-left-radius: 4px;
    }
    .message.tutor .speak-btn {
      display: inline-block; margin-left: 8px; cursor: pointer; opacity: 0.5;
      background: none; border: none; font-size: 16px; vertical-align: middle;
    }
    .message.tutor .speak-btn:hover { opacity: 1; }
    .message.tutor strong { font-weight: 700; }
    .message.tutor code {
      background: #f0f0f0; padding: 2px 4px; border-radius: 4px; font-size: 13px; font-family: monospace;
    }
    .message.tutor pre {
      background: #f0f0f0; padding: 8px 12px; border-radius: 8px; overflow-x: auto; margin: 6px 0;
    }
    .message.tutor ul, .message.tutor ol { padding-left: 20px; margin: 4px 0; }
    .message.tutor h3, .message.tutor h4 { margin: 6px 0 3px 0; font-size: 1em; }
    .score-display {
      margin: 6px 0; padding: 2px; background: #fafafa; border-radius: 8px;
      border: 1px solid #e8e8e8; overflow-x: auto; line-height: 0;
    }
    .score-display svg { display: block; margin: 0 auto; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
    .input-area {
      display: flex; gap: 8px; align-items: center;
      background: rgba(255,255,255,0.9); border: 2px solid #e5e9ff;
      border-radius: 16px; padding: 8px 12px;
    }
    .input-area input {
      flex: 1; border: none; outline: none; font-size: 15px;
      padding: 8px; background: transparent;
    }
    .input-area button {
      width: 44px; height: 44px; border: none; border-radius: 50%;
      cursor: pointer; font-size: 20px; transition: all 0.2s;
      display: flex; align-items: center; justify-content: center;
    }
    .mic-btn { background: #8e44ad; color: white; }
    .mic-btn:hover { background: #732d91; }
    .mic-btn.listening { background: #e74c3c; animation: pulse 1s infinite; }
    .send-btn { background: #1f2b4a; color: white; }
    .send-btn:hover { background: #2a3a5a; }
    .send-btn:disabled { opacity: 0.4; cursor: not-allowed; }
    @keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.1); } }
    .status-bar {
      display: flex; gap: 8px; align-items: center; padding: 4px 12px;
      font-size: 12px; color: #666; margin-bottom: 8px;
    }
    .status-bar .dot {
      width: 8px; height: 8px; border-radius: 50%; display: inline-block;
    }
    .status-bar .dot.active { background: #27ae60; animation: pulse 1s infinite; }
    .status-bar .dot.idle { background: #95a5a6; }
    .status-bar .dot.error { background: #e74c3c; }
    .loading { align-self: center; color: #999; font-style: italic; font-size: 13px; padding: 8px 0; }
    .topic-bar {
      display: flex; gap: 6px; flex-wrap: wrap; padding: 8px 0; margin-bottom: 8px;
    }
    .topic-bar button {
      padding: 4px 12px; border: 1px solid #d9d7ff; border-radius: 20px;
      background: rgba(255,255,255,0.7); cursor: pointer; font-size: 12px;
      color: #1f2b4a; transition: all 0.2s;
    }
    .topic-bar button:hover { background: #8e44ad; color: white; border-color: #8e44ad; }
    .topic-bar button.active { background: #8e44ad; color: white; border-color: #8e44ad; }
  </style>
</head>
<body>
  <div class="header">
    <h1>🎵 AI Music Tutor</h1>
    <span class="user-info"><%= user ? user.user_name : 'Guest' %></span>
  </div>

  <div class="container">
    <div class="mode-toggle">
      <button id="voiceModeBtn" class="active">🎤 Voice</button>
      <button id="textModeBtn">⌨ Text</button>
    </div>

    <div class="topic-bar" id="topicBar"></div>

    <div class="status-bar">
      <span class="dot idle" id="statusDot"></span>
      <span id="statusText">Ready</span>
    </div>

    <div class="chat-area" id="chatArea">
      <div class="message tutor">
        🎵 Hello! I'm your AI music tutor. I can quiz you on intervals, chords, scales, and more.
        Just tell me what you'd like to practice, or say "quiz me on intervals"!
      </div>
    </div>

    <div class="loading" id="loading" style="display:none;">Thinking...</div>

    <div class="input-area" id="textInputArea">
      <input type="text" id="textInput" placeholder="Type your message..." autocomplete="off">
      <button class="mic-btn" id="micBtn" title="Hold to speak / Toggle voice">🎤</button>
      <button class="send-btn" id="sendBtn">➤</button>
    </div>
  </div>

  <script>
    // ===== Configuration =====
    const USER_ID = '<%= userId %>';
    let isVoiceMode = true;
    let isListening = false;
    let recognition = null;
    let conversationHistory = [];

    // ===== DOM Elements =====
    const chatArea = document.getElementById('chatArea');
    const textInput = document.getElementById('textInput');
    const sendBtn = document.getElementById('sendBtn');
    const micBtn = document.getElementById('micBtn');
    const loading = document.getElementById('loading');
    const statusText = document.getElementById('statusText');
    const statusDot = document.getElementById('statusDot');
    const voiceModeBtn = document.getElementById('voiceModeBtn');
    const textModeBtn = document.getElementById('textModeBtn');
    const topicBar = document.getElementById('topicBar');

    // ===== Speech Recognition Setup (Web Speech API) =====
    function initSpeechRecognition() {
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (!SpeechRecognition) {
        setStatus('Speech recognition not available in this browser', 'error');
        isVoiceMode = false;
        voiceModeBtn.style.display = 'none';
        return null;
      }
      const sr = new SpeechRecognition();
      sr.continuous = true;
      sr.interimResults = true;
      sr.lang = 'en-US';
      sr.maxAlternatives = 1;
      return sr;
    }

    function setupRecognition() {
      if (recognition) {
        recognition.abort();
        recognition = null;
      }
      recognition = initSpeechRecognition();
      if (!recognition) return;

      let finalTranscript = '';

      recognition.onresult = (event) => {
        let interim = '';
        finalTranscript = '';
        for (let i = event.resultIndex; i < event.results.length; i++) {
          if (event.results[i].isFinal) {
            finalTranscript += event.results[i][0].transcript;
          } else {
            interim += event.results[i][0].transcript;
          }
        }
        if (finalTranscript) {
          textInput.value = finalTranscript;
        } else if (interim) {
          textInput.value = interim;
        }
      };

      recognition.onerror = (event) => {
        console.error('Speech error:', event.error);
        if (event.error === 'not-allowed') {
          setStatus('Microphone access denied', 'error');
          stopListening();
        } else if (event.error === 'no-speech') {
          // Ignore - user just stopped talking
        } else {
          stopListening();
        }
      };

      recognition.onend = () => {
        if (isListening) {
          // Auto-send when user stops speaking (if we have final text)
          if (finalTranscript) {
            sendMessage(finalTranscript.trim());
          }
          // In continuous mode, restart
          try { recognition.start(); } catch(e) {}
        } else {
          setStatus('Ready', 'idle');
        }
      };
    }

    // ===== Markdown Helpers =====
    function stripMarkdown(md) {
      return md
        .replace(/\*\*(.+?)\*\*/g, '$1')
        .replace(/\*(.+?)\*/g, '$1')
        .replace(/__(.+?)__/g, '$1')
        .replace(/_(.+?)_/g, '$1')
        .replace(/`{1,3}[^`]*`{1,3}/g, '')
        .replace(/~~(.+?)~~/g, '$1')
        .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
        .replace(/#{1,6}\s/g, '')
        .replace(/^[-*+]\s/gm, '')
        .replace(/^\d+\.\s/gm, '')
        .replace(/>\s/g, '')
        .replace(/\n{3,}/g, '\n')
        .trim();
    }

    // ===== VexFlow Score Rendering =====
    function renderScore(container, displayData, topic) {
      if (!displayData || !window.Vex) return;
      try {
        const VF = Vex.Flow;
        const containerDiv = document.createElement('div');
        containerDiv.className = 'score-display';
        container.appendChild(containerDiv);

        const renderer = new VF.Renderer(containerDiv, VF.Renderer.Backends.SVG);
        renderer.resize(280, 120);
        const ctx = renderer.getContext();

        if (topic === 'interval' && displayData.vexNotes && displayData.clefs) {
          const clef = displayData.clefs[0] || 'treble';
          const stave = new VF.Stave(5, 15, 270);
          stave.addClef(clef).setContext(ctx).draw();

          const notes = displayData.vexNotes.map(n => {
            const note = new VF.StaveNote({ keys: [n.key], duration: 'q', clef });
            if (n.accidental && n.accidental !== 'n' && n.accidental !== '') {
              note.addModifier(new VF.Accidental(n.accidental), 0);
            }
            return note;
          });

          const voice = new VF.Voice({ num_beats: displayData.vexNotes.length, beat_value: 4 });
          voice.addTickables(notes);
          new VF.Formatter().joinVoices([voice]).format([voice], 250);
          voice.draw(ctx, stave);

        } else if (topic === 'pitch_id' && displayData.vexKey) {
          const clef = displayData.clef || 'treble';
          const stave = new VF.Stave(5, 15, 270);
          stave.addClef(clef).setContext(ctx).draw();

          const note = new VF.StaveNote({ keys: [displayData.vexKey], duration: 'w', clef });
          if (displayData.accidental && displayData.accidental !== 'n' && displayData.accidental !== '') {
            note.addModifier(new VF.Accidental(displayData.accidental), 0);
          }

          const voice = new VF.Voice({ num_beats: 4, beat_value: 4 });
          voice.addTickables([note]);
          new VF.Formatter().joinVoices([voice]).format([voice], 250);
          voice.draw(ctx, stave);

        } else if (topic === 'inversion' && displayData.vexNotes) {
          const clef = displayData.clef || 'treble';
          const stave = new VF.Stave(5, 15, 270);
          stave.addClef(clef).setContext(ctx).draw();

          const notes = displayData.vexNotes.map(n => {
            const note = new VF.StaveNote({ keys: [n.key], duration: 'h', clef });
            if (n.accidental && n.accidental !== '') {
              note.addModifier(new VF.Accidental(n.accidental), 0);
            }
            return note;
          });

          const voice = new VF.Voice({ num_beats: 4, beat_value: 4 });
          voice.addTickables(notes);
          new VF.Formatter().joinVoices([voice]).format([voice], 250);
          voice.draw(ctx, stave);
        }
      } catch (err) {
        console.warn('Score render error:', err.message);
      }
    }

    // ===== TTS (Speech Synthesis) =====
    function speak(text) {
      if (!window.speechSynthesis) return;
      window.speechSynthesis.cancel();
      const clean = stripMarkdown(text);
      const utterance = new SpeechSynthesisUtterance(clean);
      utterance.rate = 0.95;
      utterance.pitch = 1.0;
      utterance.volume = 1.0;
      const voices = window.speechSynthesis.getVoices();
      const preferredVoice = voices.find(v => v.lang.startsWith('en') && v.name.includes('Female'))
        || voices.find(v => v.lang.startsWith('en') && v.name.includes('Google'))
        || voices.find(v => v.lang.startsWith('en'));
      if (preferredVoice) utterance.voice = preferredVoice;
      window.speechSynthesis.speak(utterance);
    }

    // ===== UI Helpers =====
    function setStatus(text, type) {
      statusText.textContent = text;
      statusDot.className = 'dot ' + (type || 'idle');
    }

    function addMessage(text, sender) {
      const div = document.createElement('div');
      div.className = 'message ' + sender;
      if (sender === 'tutor') {
        div.innerHTML = marked.parse(text);
        const speakBtn = document.createElement('button');
        speakBtn.className = 'speak-btn';
        speakBtn.textContent = '🔊';
        speakBtn.title = 'Read aloud';
        speakBtn.onclick = () => speak(text);
        div.appendChild(speakBtn);
        if (isVoiceMode) setTimeout(() => speak(text), 300);
      } else {
        div.textContent = text;
      }
      chatArea.appendChild(div);
      chatArea.scrollTop = chatArea.scrollHeight;
      return div;
    }

    // ===== Topic Loading =====
    async function loadTopics() {
      try {
        // We can get topics from the server
        const topics = [
          'interval', 'pitch_id', 'chromatic', 'clef_minor',
          'inversion', 'melody_key', 'transposing', 'same_pitch',
          'instrument_knowledge', 'compound_simple', 'duration_equation'
        ];
        topicBar.innerHTML = topics.map(t => `<button onclick="quickTopic('${t}')">${t.replace(/_/g, ' ')}</button>`).join('');
      } catch(e) {}
    }
    loadTopics();

    function quickTopic(topic) {
      sendMessage(`Let's practice ${topic.replace(/_/g, ' ')}!`);
    }

    // ===== API Communication =====
    async function sendMessage(text) {
      if (!text.trim()) return;
      textInput.value = '';
      addMessage(text, 'user');
      loading.style.display = 'block';
      setStatus('Thinking...', 'active');
      sendBtn.disabled = true;

      try {
        const response = await fetch('/tutor/api/message', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            message: text,
            mode: isVoiceMode ? 'voice' : 'text',
            history: conversationHistory
          })
        });

        const data = await response.json();
        if (data.error) {
          addMessage('Error: ' + data.error, 'tutor');
        } else {
          const msgEl = addMessage(data.reply, 'tutor');
          // Render score if question has notation data
          if (data.displayData && data.toolCalls?.some?.(tc => tc.name === 'generate_question')) {
            const genCall = data.toolCalls.find(tc => tc.name === 'generate_question');
            renderScore(msgEl, data.displayData, genCall?.args?.topic);
          }
          conversationHistory.push(
            { role: 'user', content: text },
            { role: 'assistant', content: data.reply }
          );
        }
      } catch (err) {
        addMessage('Sorry, I encountered an error. Please try again.', 'tutor');
      } finally {
        loading.style.display = 'none';
        setStatus('Ready', 'idle');
        sendBtn.disabled = false;
        textInput.focus();
      }
    }

    // ===== Voice Controls =====
    function startListening() {
      if (!recognition) setupRecognition();
      if (!recognition) { setStatus('Speech not available', 'error'); return; }
      isListening = true;
      try { recognition.start(); } catch(e) {}
      micBtn.classList.add('listening');
      setStatus('Listening...', 'active');
      textInput.placeholder = 'Speak now...';
    }

    function stopListening() {
      isListening = false;
      if (recognition) { try { recognition.stop(); } catch(e) {} }
      micBtn.classList.remove('listening');
      setStatus('Ready', 'idle');
      textInput.placeholder = 'Type your message...';
    }

    function toggleListening() {
      if (isListening) stopListening();
      else startListening();
    }

    // ===== Mode Toggle =====
    function setMode(voice) {
      isVoiceMode = voice;
      voiceModeBtn.classList.toggle('active', voice);
      textModeBtn.classList.toggle('active', !voice);
      if (voice) {
        setupRecognition();
      } else {
        stopListening();
      }
    }

    // ===== Event Listeners =====
    voiceModeBtn.onclick = () => setMode(true);
    textModeBtn.onclick = () => setMode(false);

    micBtn.onclick = toggleListening;
    sendBtn.onclick = () => {
      if (isListening) stopListening();
      sendMessage(textInput.value);
    };

    textInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        if (isListening) stopListening();
        sendMessage(textInput.value);
      }
    });

    // Load voices for TTS
    if (window.speechSynthesis) {
      window.speechSynthesis.onvoiceschanged = () => { window.speechSynthesis.getVoices(); };
    }

    // Initialize
    setTimeout(() => {
      setupRecognition();
      if (isVoiceMode && recognition) {
        setStatus('🎤 Say something to start', 'idle');
      }
    }, 500);
  </script>
</body>
</html>
