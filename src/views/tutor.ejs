<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  <script src="/scripts/vexflow/vexflow.js"></script>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(160deg, #fff4d6 0%, #ffe0f0 35%, #ddf8ff 72%, #e4ffef 100%);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    .header {
      background: #1f2b4a;
      color: white;
      padding: 16px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .header h1 { font-size: 20px; display: flex; align-items: center; gap: 8px; }
    .header .user-info { font-size: 13px; opacity: 0.8; }
    .container {
      flex: 1; display: flex; flex-direction: column; max-width: 800px;
      margin: 0 auto; width: 100%; padding: 16px;
    }
    .chat-area {
      flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column;
      gap: 12px; background: rgba(255,255,255,0.85); border-radius: 16px;
      border: 2px solid #e5e9ff; margin-bottom: 12px; min-height: 400px;
    }
    .message {
      max-width: 85%; padding: 12px 16px; border-radius: 14px;
      line-height: 1.5; font-size: 15px; word-wrap: break-word; animation: fadeIn 0.3s;
    }
    .message.user {
      align-self: flex-end; background: #8e44ad; color: white;
      border-bottom-right-radius: 4px;
    }
    .message.tutor {
      align-self: flex-start; background: white; color: #1f2b4a;
      border: 1px solid #e0e0e0; border-bottom-left-radius: 4px;
    }
    .message.tutor .speak-btn {
      display: inline-block; margin-left: 8px; cursor: pointer; opacity: 0.5;
      background: none; border: none; font-size: 16px; vertical-align: middle;
    }
    .message.tutor .speak-btn:hover { opacity: 1; }
    .message.tutor strong { font-weight: 700; }
    .message.tutor code {
      background: #f0f0f0; padding: 2px 4px; border-radius: 4px; font-size: 13px; font-family: monospace;
    }
    .message.tutor pre {
      background: #f0f0f0; padding: 8px 12px; border-radius: 8px; overflow-x: auto; margin: 6px 0;
    }
    .message.tutor ul, .message.tutor ol { padding-left: 20px; margin: 4px 0; }
    .message.tutor h3, .message.tutor h4 { margin: 6px 0 3px 0; font-size: 1em; }
    .score-display {
      margin: 6px 0; padding: 2px; background: #fafafa; border-radius: 8px;
      border: 1px solid #e8e8e8; overflow-x: auto; line-height: 0;
    }
    .score-display svg { display: block; margin: 0 auto; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
    .input-area {
      display: flex; gap: 8px; align-items: center;
      background: rgba(255,255,255,0.9); border: 2px solid #e5e9ff;
      border-radius: 16px; padding: 8px 12px;
    }
    .input-area input {
      flex: 1; border: none; outline: none; font-size: 15px;
      padding: 8px; background: transparent;
    }
    .input-area button {
      width: 44px; height: 44px; border: none; border-radius: 50%;
      cursor: pointer; font-size: 20px; transition: all 0.2s;
      display: flex; align-items: center; justify-content: center;
    }
    .mic-btn { background: #8e44ad; color: white; }
    .mic-btn:hover { background: #732d91; }
    .mic-btn.listening { background: #e74c3c; animation: pulse 1s infinite; }
    .send-btn { background: #1f2b4a; color: white; }
    .send-btn:hover { background: #2a3a5a; }
    .send-btn:disabled { opacity: 0.4; cursor: not-allowed; }
    @keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.1); } }
    .fold-bar {
      text-align: center; padding: 8px 12px; margin: 4px 0;
      background: rgba(31,43,74,0.06); border-radius: 12px;
      cursor: pointer; font-size: 12px; color: #666;
      transition: background 0.2s;
    }
    .fold-bar:hover { background: rgba(31,43,74,0.12); }
    .mute-btn {
      background: none; border: 1px solid rgba(255,255,255,0.3); border-radius: 8px;
      color: white; font-size: 18px; cursor: pointer; padding: 4px 8px;
      transition: all 0.2s; line-height: 1;
    }
    .mute-btn:hover { background: rgba(255,255,255,0.15); border-color: rgba(255,255,255,0.5); }
    .mute-btn.muted { opacity: 0.5; text-decoration: line-through; }
    .status-bar {
      display: flex; gap: 8px; align-items: center; padding: 4px 12px;
      font-size: 12px; color: #666; margin-bottom: 8px;
    }
    .status-bar .dot {
      width: 8px; height: 8px; border-radius: 50%; display: inline-block;
    }
    .status-bar .dot.active { background: #27ae60; animation: pulse 1s infinite; }
    .status-bar .dot.idle { background: #95a5a6; }
    .status-bar .dot.error { background: #e74c3c; }
    .loading { align-self: center; color: #999; font-style: italic; font-size: 13px; padding: 8px 0; }
    .topic-bar {
      display: flex; gap: 6px; flex-wrap: wrap; padding: 8px 0; margin-bottom: 8px;
    }
    .topic-bar button {
      padding: 4px 12px; border: 1px solid #d9d7ff; border-radius: 20px;
      background: rgba(255,255,255,0.7); cursor: pointer; font-size: 12px;
      color: #1f2b4a; transition: all 0.2s;
    }
    .topic-bar button:hover { background: #8e44ad; color: white; border-color: #8e44ad; }
    .topic-bar button.active { background: #8e44ad; color: white; border-color: #8e44ad; }
  </style>
</head>
<body>
  <div class="header">
    <h1>🎵 AI Music Tutor</h1>
    <div style="display:flex;align-items:center;gap:8px;">
      <button id="muteBtn" class="mute-btn" title="Toggle text-to-speech">🔊</button>
      <span class="user-info"><%= user ? user.user_name : 'Guest' %></span>
    </div>
  </div>

  <div class="container">
    <div class="topic-bar" id="topicBar"></div>

    <div class="status-bar">
      <span class="dot idle" id="statusDot"></span>
      <span id="statusText">Ready</span>
    </div>

    <div class="chat-area" id="chatArea">
      <div class="message tutor">
        🎵 Hello! I'm your AI music tutor. I can quiz you on intervals, chords, scales, and more.
        Just tell me what you'd like to practice, or say "quiz me on intervals"!
      </div>
    </div>

    <div class="loading" id="loading" style="display:none;">Thinking...</div>

    <div class="input-area" id="textInputArea">
      <input type="text" id="textInput" placeholder="Type your message..." autocomplete="off">
      <button class="mic-btn" id="micBtn" title="Hold to speak / Toggle voice">🎤</button>
      <button class="send-btn" id="sendBtn">➤</button>
    </div>
  </div>

  <script>
    // ===== Configuration =====
    const USER_ID = '<%= userId %>';
    let isVoiceMode = true;
    let isListening = false;
    let recognition = null;
    let isMuted = false;
    const savedHistory = <%- typeof savedHistory !== 'undefined' ? savedHistory : '[]' %>;
    let conversationHistory = savedHistory || [];

    // ===== DOM Elements =====
    const chatArea = document.getElementById('chatArea');
    const textInput = document.getElementById('textInput');
    const sendBtn = document.getElementById('sendBtn');
    const micBtn = document.getElementById('micBtn');
    const loading = document.getElementById('loading');
    const statusText = document.getElementById('statusText');
    const statusDot = document.getElementById('statusDot');
    const voiceModeBtn = null;
    const textModeBtn = null;
    const topicBar = document.getElementById('topicBar');

    // ===== Speech Recognition Setup (Web Speech API) =====
    function initSpeechRecognition() {
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (!SpeechRecognition) {
        setStatus('Speech recognition not available in this browser', 'error');
        isVoiceMode = false;
        return null;
      }
      const sr = new SpeechRecognition();
      sr.continuous = true;
      sr.interimResults = true;
      sr.lang = 'en-US';
      sr.maxAlternatives = 1;
      return sr;
    }

    function setupRecognition() {
      if (recognition) {
        recognition.abort();
        recognition = null;
      }
      recognition = initSpeechRecognition();
      if (!recognition) return;

      let finalTranscript = '';

      recognition.onresult = (event) => {
        let interim = '';
        finalTranscript = '';
        for (let i = event.resultIndex; i < event.results.length; i++) {
          if (event.results[i].isFinal) {
            finalTranscript += event.results[i][0].transcript;
          } else {
            interim += event.results[i][0].transcript;
          }
        }
        if (finalTranscript) {
          textInput.value = finalTranscript;
        } else if (interim) {
          textInput.value = interim;
        }
      };

      recognition.onerror = (event) => {
        console.error('Speech error:', event.error);
        if (event.error === 'not-allowed') {
          setStatus('Microphone access denied', 'error');
          stopListening();
        } else if (event.error === 'no-speech') {
          // Ignore - user just stopped talking
        } else {
          stopListening();
        }
      };

      recognition.onend = () => {
        if (isListening) {
          // Auto-send when user stops speaking (if we have final text)
          if (finalTranscript) {
            sendMessage(finalTranscript.trim());
          }
          // In continuous mode, restart
          try { recognition.start(); } catch(e) {}
        } else {
          setStatus('Ready', 'idle');
        }
      };
    }

    // ===== Markdown Helpers =====
    function stripMarkdown(md) {
      return md
        .replace(/\*\*(.+?)\*\*/g, '$1')
        .replace(/\*(.+?)\*/g, '$1')
        .replace(/__(.+?)__/g, '$1')
        .replace(/_(.+?)_/g, '$1')
        .replace(/`{1,3}[^`]*`{1,3}/g, '')
        .replace(/~~(.+?)~~/g, '$1')
        .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
        .replace(/#{1,6}\s/g, '')
        .replace(/^[-*+]\s/gm, '')
        .replace(/^\d+\.\s/gm, '')
        .replace(/>\s/g, '')
        .replace(/\n{3,}/g, '\n')
        .trim();
    }

    // ===== VexFlow Score Rendering =====
    function calcScoreLayout(keys, clef) {
      const noteLetters = ['c','d','e','f','g','a','b'];
      const clefTopRoom = 45;
      const clefBottomRoom = 45;
      const staffH = 40;

      // Bottom line of the staff for each clef (note index = octave * 7 + letterIdx)
      const staffBottom = { treble: 30, bass: 18, alto: 25, tenor: 23 };
      const bottomRef = staffBottom[clef] || 30;

      let deepest = Infinity;
      for (const k of keys) {
        const m = k.match(/^([a-g])[#bn]*\/(\d+)$/i);
        if (!m) continue;
        const letter = m[1].toLowerCase();
        const octave = parseInt(m[2]);
        const idx = noteLetters.indexOf(letter);
        if (idx < 0) continue;
        deepest = Math.min(deepest, octave * 7 + idx);
      }
      const ledgerExtra = isFinite(deepest) ? Math.max(0, (bottomRef - deepest) * 8) : 0;
      const height = clefTopRoom + staffH + clefBottomRoom + ledgerExtra;
      return {
        width: 280,
        height: height,
        staveY: clefTopRoom,
        formatWidth: 250
      };
    }

    function renderScore(container, displayData, topic) {
      const VF = window.VexFlow;
      if (!displayData || !VF) return;
      try {
        const containerDiv = document.createElement('div');
        containerDiv.className = 'score-display';
        container.appendChild(containerDiv);

        // ── Transpose note key for clef: VexFlow positions by absolute pitch ──
        // Bass: +5 letter steps (A→C), Tenor: +1, Alto: -1
        const noteLetters = ['c','d','e','f','g','a','b'];
        const clefTranspose = { bass: 5, tenor: 1, alto: -1 };
        function transposeKey(key, clef) {
          const shift = clefTranspose[clef];
          if (!shift) return key;
          const m = key.match(/^([a-g])([#bn]*)\/(\d+)$/i);
          if (!m) return key;
          let letter = m[1].toLowerCase();
          let acc = m[2] || '';
          let oct = parseInt(m[3], 10);
          const idx = noteLetters.indexOf(letter);
          if (idx < 0) return key;
          let newIdx = idx + shift;
          while (newIdx < 0) { newIdx += 7; oct--; }
          while (newIdx >= 7) { newIdx -= 7; oct++; }
          return noteLetters[newIdx] + (acc === 'n' ? '' : acc) + '/' + oct;
        }

        if (topic === 'interval' && displayData.vexNotes && displayData.clefs) {
          const clef = displayData.clefs[0] || 'treble';
          const shiftedKeys = displayData.vexNotes.map(n => transposeKey(n.key, clef));
          const layout = calcScoreLayout(shiftedKeys, clef);

          const renderer = new VF.Renderer(containerDiv, VF.Renderer.Backends.SVG);
          renderer.resize(layout.width, layout.height);
          const ctx = renderer.getContext();

          const stave = new VF.Stave(5, layout.staveY, 270);
          stave.addClef(clef).setContext(ctx).draw();

          const notes = displayData.vexNotes.map((n, i) => {
            const note = new VF.StaveNote({ keys: [shiftedKeys[i]], duration: 'q' });
            note.getStem().setVisibility(false);
            if (n.accidental && n.accidental !== 'n' && n.accidental !== '') {
              note.addModifier(new VF.Accidental(n.accidental));
            }
            return note;
          });

          const voice = new VF.Voice({ numBeats: displayData.vexNotes.length, beatValue: 4 });
          voice.addTickables(notes);
          new VF.Formatter().joinVoices([voice]).format([voice], layout.formatWidth);
          voice.draw(ctx, stave);
          ctx.setViewBox(0, 40, layout.width, layout.height);

        } else if (topic === 'pitch_id' && displayData.vexKey) {
          const clef = displayData.clef || 'treble';
          const shiftedKey = transposeKey(displayData.vexKey, clef);
          const layout = calcScoreLayout([shiftedKey], clef);

          const renderer = new VF.Renderer(containerDiv, VF.Renderer.Backends.SVG);
          renderer.resize(layout.width, layout.height);
          const ctx = renderer.getContext();

          const stave = new VF.Stave(5, layout.staveY, 270);
          stave.addClef(clef).setContext(ctx).draw();

          const note = new VF.StaveNote({ keys: [shiftedKey], duration: 'w' });
          note.getStem().setVisibility(false);
          if (displayData.accidental && displayData.accidental !== 'n' && displayData.accidental !== '') {
            note.addModifier(new VF.Accidental(displayData.accidental));
          }

          const voice = new VF.Voice({ numBeats: 4, beatValue: 4 });
          voice.addTickables([note]);
          new VF.Formatter().joinVoices([voice]).format([voice], layout.formatWidth);
          voice.draw(ctx, stave);
          ctx.setViewBox(0, 40, layout.width, layout.height);

        } else if (topic === 'inversion' && displayData.vexNotes) {
          const clef = displayData.clef || 'treble';
          const shiftedKeys = displayData.vexNotes.map(n => transposeKey(n.key, clef));
          const layout = calcScoreLayout(shiftedKeys, clef);

          const renderer = new VF.Renderer(containerDiv, VF.Renderer.Backends.SVG);
          renderer.resize(layout.width, layout.height);
          const ctx = renderer.getContext();

          const stave = new VF.Stave(5, layout.staveY, 270);
          stave.addClef(clef).setContext(ctx).draw();

          const notes = displayData.vexNotes.map((n, i) => {
            const note = new VF.StaveNote({ keys: [shiftedKeys[i]], duration: 'h' });
            if (n.accidental && n.accidental !== '') {
              note.addModifier(new VF.Accidental(n.accidental), 0);
            }
            return note;
          });

          const voice = new VF.Voice({ numBeats: 4, beatValue: 4 });
          voice.addTickables(notes);
          new VF.Formatter().joinVoices([voice]).format([voice], layout.formatWidth);
          voice.draw(ctx, stave);
        } else if (topic === 'chromatic' && displayData.options) {
          const clef = displayData.clef || 'treble';
          const gap = 10;
          const svgW = Math.min(window.innerWidth - 60, 700);

          const perOption = displayData.options.map(opt => {
            const keys = (opt.scale || []).map(n => {
              const m = n.match(/^([a-g])([#bn]*)\/(\d+)$/i);
              if (!m) return { key: 'c/4', acc: '' };
              const acc = m[2] || '';
              // Keep 'n' so addModifier(new VF.Accidental('n')) renders the natural glyph
              return { key: m[1].toLowerCase() + '/' + m[3], acc: acc };
            });
            const layout = calcScoreLayout(keys.map(k => k.key), clef);
            return { keys, layout };
          });

          let svgH = 10;
          const staveYs = [];
          for (const o of perOption) { staveYs.push(svgH); svgH += o.layout.height + gap; }

          const renderer = new VF.Renderer(containerDiv, VF.Renderer.Backends.SVG);
          renderer.resize(svgW, svgH);
          const ctx = renderer.getContext();

          perOption.forEach((opt, i) => {
            const staveY = staveYs[i];
            const stave = new VF.Stave(5, staveY, svgW - 10);
            stave.addClef(clef).setContext(ctx).draw();

            const notes = opt.keys.map(k => {
              const dur = '8';
              const note = new VF.StaveNote({ keys: [transposeKey(k.key, clef)], duration: dur });
              if (k.acc && k.acc !== '') {
                note.addModifier(new VF.Accidental(k.acc));
              }
              return note;
            });

            const beams = VF.Beam.generateBeams(notes);
            VF.Formatter.FormatAndDraw(ctx, stave, notes);
            beams.forEach(b => b.setContext(ctx).draw());
          });

        } else if (topic === 'clef_minor' && displayData.minorScale) {
          const clef = displayData.clef || 'treble';
          const svgW = Math.min(window.innerWidth - 60, 480);
          const keys = displayData.minorScale.map(n => {
            const m = n.match(/^([a-g])([sfn]*)(['|,]*)$/);
            if (!m) return { key: 'c/4', acc: '' };
            let step = m[1], acc = m[2], octMod = m[3];
            let accidental = '';
            if (acc === 's') accidental = '#';
            else if (acc === 'ss') accidental = '##';
            else if (acc === 'f') accidental = 'b';
            else if (acc === 'ff') accidental = 'bb';
            else if (acc === 'n') accidental = 'n';
            let oct = 4;
            for (let c of octMod) { if (c === "'") oct++; if (c === ',') oct--; }
            return { key: step + accidental + '/' + oct, acc: accidental };
          });
          const layout = calcScoreLayout(keys.map(k => k.key), clef);
          const renderer = new VF.Renderer(containerDiv, VF.Renderer.Backends.SVG);
          renderer.resize(svgW, layout.height);
          const ctx = renderer.getContext();
          const stave = new VF.Stave(5, layout.staveY, svgW - 10);
          stave.addClef(clef).setContext(ctx).draw();
          const notes = keys.map(k => {
            const note = new VF.StaveNote({ keys: [transposeKey(k.key, clef)], duration: 'q' });
            if (k.acc && k.acc !== '') note.addModifier(new VF.Accidental(k.acc), 0);
            return note;
          });
          const voice = new VF.Voice({ numBeats: keys.length, beatValue: 4 });
          voice.addTickables(notes);
          new VF.Formatter().joinVoices([voice]).format([voice], svgW - 50);
          voice.draw(ctx, stave);

        } else if (topic === 'melody_key' && displayData.vexNotes) {
          const clef = displayData.clef || 'treble';
          const svgW = Math.min(window.innerWidth - 60, 550);
          const keys = displayData.vexNotes.map(n => n.keys ? n.keys[0] : 'c/4');
          const layout = calcScoreLayout(keys, clef);
          const renderer = new VF.Renderer(containerDiv, VF.Renderer.Backends.SVG);
          renderer.resize(svgW, layout.height);
          const ctx = renderer.getContext();
          const stave = new VF.Stave(5, layout.staveY, svgW - 10);
          stave.addClef(clef).setContext(ctx).draw();
          const beatMap = { w: 4, h: 2, q: 1, '8': 0.5, '16': 0.25, qd: 1.5, '8d': 0.75 };
          const notes = displayData.vexNotes.map(n => {
            const dur = (n.duration || 'q').replace(/\d+d?$/, m => {
              if (m.endsWith('d')) return m.slice(0, -1) + 'd';
              return m;
            }).replace(/^(\d+)n/, '$1');
            const noteKeys = (n.keys || [n.key || 'c/4']).map(k => transposeKey(k, clef));
            const note = new VF.StaveNote({ keys: noteKeys, duration: dur || 'q' });
            if (n.accidental && n.accidental !== '') {
              note.addModifier(new VF.Accidental(n.accidental), 0);
            }
            return note;
          });
          const totalBeats = displayData.vexNotes.reduce((s, n) => {
            let d = (n.duration || 'q').replace('n', '').replace('d', '').replace('.', '');
            return s + (beatMap[d] || 1);
          }, 0);
          const voice = new VF.Voice({ numBeats: Math.max(totalBeats, 1), beatValue: 4 });
          voice.addTickables(notes);
          new VF.Formatter().joinVoices([voice]).format([voice], svgW - 50);
          voice.draw(ctx, stave);

        } else if (topic === 'transposing' && displayData.originalVexData) {
          const clef = displayData.clef || 'treble';
          const svgW = Math.min(window.innerWidth - 60, 500);
          const keys = displayData.originalVexData.map(n => n.key || 'c/4');
          const layout = calcScoreLayout(keys, clef);
          const renderer = new VF.Renderer(containerDiv, VF.Renderer.Backends.SVG);
          renderer.resize(svgW, layout.height);
          const ctx = renderer.getContext();
          const stave = new VF.Stave(5, layout.staveY, svgW - 10);
          stave.addClef(clef).setContext(ctx).draw();
          const notes = displayData.originalVexData.map(n => {
            const note = new VF.StaveNote({ keys: [transposeKey(n.key || 'c/4', clef)], duration: 'q' });
            if (n.accidental && n.accidental !== '') {
              note.addModifier(new VF.Accidental(n.accidental));
            }
            return note;
          });
          const voice = new VF.Voice({ numBeats: notes.length, beatValue: 4 });
          voice.addTickables(notes);
          new VF.Formatter().joinVoices([voice]).format([voice], svgW - 50);
          voice.draw(ctx, stave);

        } else if (topic === 'same_pitch' && displayData.options) {
          const gap = 8;
          const svgW = Math.min(window.innerWidth - 60, 400);
          // Calculate per-option layouts
          const layouts = displayData.options.map(opt =>
            calcScoreLayout(opt.keys || ['c/4'], opt.clef || 'treble')
          );
          let svgH = 10;
          const staveYs = [];
          for (const l of layouts) {
            staveYs.push(svgH);
            svgH += l.height + gap;
          }
          const renderer = new VF.Renderer(containerDiv, VF.Renderer.Backends.SVG);
          renderer.resize(svgW, svgH);
          const ctx = renderer.getContext();
          displayData.options.forEach((opt, i) => {
            const staveY = staveYs[i];
            const stave = new VF.Stave(5, staveY, svgW - 10);
            stave.addClef(opt.clef || 'treble').setContext(ctx).draw();
            const notes = (opt.keys || []).map(k => {
              const note = new VF.StaveNote({ keys: [transposeKey(k, opt.clef || 'treble')], duration: 'q' });
              try { note.setStemStyle({ visible: false }); } catch(e) {}
              return note;
            });
            const voice = new VF.Voice({ numBeats: (opt.keys || []).length, beatValue: 4 });
            voice.addTickables(notes);
            new VF.Formatter().joinVoices([voice]).format([voice], svgW - 50);
            voice.draw(ctx, stave);
          });
        } else if (topic === 'instrument_knowledge' && displayData.imageUrl) {
          const img = document.createElement('img');
          img.src = displayData.imageUrl;
          img.style.maxWidth = '100%';
          img.style.borderRadius = '8px';
          img.style.marginTop = '4px';
          container.appendChild(img);
        }
      } catch (err) {
        console.warn('Score render error:', err.message);
      }
    }

    // ===== TTS (Speech Synthesis) =====
    function speak(text) {
      if (isMuted) return;
      if (!window.speechSynthesis) return;
      window.speechSynthesis.cancel();
      const clean = stripMarkdown(text);
      const utterance = new SpeechSynthesisUtterance(clean);
      utterance.rate = 0.95;
      utterance.pitch = 1.0;
      utterance.volume = 1.0;
      const voices = window.speechSynthesis.getVoices();
      const preferredVoice = voices.find(v => v.lang.startsWith('en') && v.name.includes('Female'))
        || voices.find(v => v.lang.startsWith('en') && v.name.includes('Google'))
        || voices.find(v => v.lang.startsWith('en'));
      if (preferredVoice) utterance.voice = preferredVoice;
      window.speechSynthesis.speak(utterance);
    }

    // ===== UI Helpers =====
    function setStatus(text, type) {
      statusText.textContent = text;
      statusDot.className = 'dot ' + (type || 'idle');
    }

    function addMessage(text, sender) {
      const div = document.createElement('div');
      div.className = 'message ' + sender;
      if (sender === 'tutor') {
        div.innerHTML = marked.parse(text);
        const speakBtn = document.createElement('button');
        speakBtn.className = 'speak-btn';
        speakBtn.textContent = '🔊';
        speakBtn.title = 'Read aloud';
        speakBtn.onclick = () => speak(text);
        div.appendChild(speakBtn);
        if (isVoiceMode) setTimeout(() => speak(text), 300);
      } else {
        div.textContent = text;
      }
      chatArea.appendChild(div);
      chatArea.scrollTop = chatArea.scrollHeight;
      return div;
    }

    // Restore saved chat history on page load — show last 10, fold older ones
    const MAX_VISIBLE = 10;
    if (conversationHistory.length > 0) {
      chatArea.innerHTML = ''; // clear welcome message
      const olderCount = conversationHistory.length - MAX_VISIBLE;
      if (olderCount > 0) {
        // Show a "show older" bar above the recent messages
        const foldBar = document.createElement('div');
        foldBar.className = 'fold-bar';
        foldBar.textContent = `… ${olderCount} earlier message${olderCount !== 1 ? 's' : ''} (click to show)`;
        foldBar.onclick = function () {
          // Replace fold bar and recent messages with full history
          chatArea.innerHTML = '';
          conversationHistory.forEach(msg => addMessage(msg.content, msg.role === 'user' ? 'user' : 'tutor'));
        };
        chatArea.appendChild(foldBar);
        // Render only the last MAX_VISIBLE messages
        conversationHistory.slice(-MAX_VISIBLE).forEach(msg =>
          addMessage(msg.content, msg.role === 'user' ? 'user' : 'tutor')
        );
      } else {
        conversationHistory.forEach(msg => addMessage(msg.content, msg.role === 'user' ? 'user' : 'tutor'));
      }
    }

    // ===== Topic Loading =====
    async function loadTopics() {
      try {
        // We can get topics from the server
        const topics = [
          'interval', 'pitch_id', 'chromatic', 'clef_minor',
          'inversion', 'melody_key', 'transposing', 'same_pitch',
          'instrument_knowledge', 'compound_simple', 'duration_equation'
        ];
        topicBar.innerHTML = topics.map(t => `<button onclick="quickTopic('${t}')">${t.replace(/_/g, ' ')}</button>`).join('');
      } catch(e) {}
    }
    loadTopics();

    function quickTopic(topic) {
      sendMessage(`Let's practice ${topic.replace(/_/g, ' ')}!`);
    }

    // ===== API Communication =====
    async function sendMessage(text) {
      if (!text.trim()) return;
      textInput.value = '';
      addMessage(text, 'user');
      loading.style.display = 'block';
      setStatus('Thinking...', 'active');
      sendBtn.disabled = true;

      try {
        const response = await fetch('/tutor/api/message', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            message: text,
            mode: isVoiceMode ? 'voice' : 'text',
            history: conversationHistory
          })
        });

        const data = await response.json();
        if (data.error) {
          addMessage('Error: ' + data.error, 'tutor');
        } else {
          const msgEl = addMessage(data.reply, 'tutor');
          if (data.displayData && data.toolCalls?.some?.(tc => tc.name === 'generate_question')) {
            const genCall = data.toolCalls.find(tc => tc.name === 'generate_question');
            const topic = genCall?.args?.topic || data.topic;
            renderScore(msgEl, data.displayData, topic);
          }
          conversationHistory.push(
            { role: 'user', content: text },
            { role: 'assistant', content: data.reply }
          );
        }
      } catch (err) {
        addMessage('Sorry, I encountered an error. Please try again.', 'tutor');
      } finally {
        loading.style.display = 'none';
        setStatus('Ready', 'idle');
        sendBtn.disabled = false;
        textInput.focus();
      }
    }

    // ===== Voice Controls =====
    function startListening() {
      if (!recognition) setupRecognition();
      if (!recognition) { setStatus('Speech not available', 'error'); return; }
      isListening = true;
      try { recognition.start(); } catch(e) {}
      micBtn.classList.add('listening');
      setStatus('Listening...', 'active');
      textInput.placeholder = 'Speak now...';
    }

    function stopListening() {
      isListening = false;
      if (recognition) { try { recognition.stop(); } catch(e) {} }
      micBtn.classList.remove('listening');
      setStatus('Ready', 'idle');
      textInput.placeholder = 'Type your message...';
    }

    function toggleListening() {
      if (isListening) stopListening();
      else startListening();
    }

    // ===== Mode Toggle =====
    function setMode(voice) {
      isVoiceMode = voice;
    }

    // ===== Event Listeners =====
    // ===== Mute Toggle =====
    const muteBtn = document.getElementById('muteBtn');
    function toggleMute() {
      isMuted = !isMuted;
      muteBtn.textContent = isMuted ? '🔇' : '🔊';
      muteBtn.classList.toggle('muted', isMuted);
      muteBtn.title = isMuted ? 'Unmute text-to-speech' : 'Mute text-to-speech';
      if (isMuted && window.speechSynthesis) window.speechSynthesis.cancel();
    }
    muteBtn.onclick = toggleMute;

    micBtn.onclick = toggleListening;
    sendBtn.onclick = () => {
      if (isListening) stopListening();
      sendMessage(textInput.value);
    };

    textInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        if (isListening) stopListening();
        sendMessage(textInput.value);
      }
    });

    // Load voices for TTS
    if (window.speechSynthesis) {
      window.speechSynthesis.onvoiceschanged = () => { window.speechSynthesis.getVoices(); };
    }

    // Initialize
    setTimeout(() => {
      setupRecognition();
      if (isVoiceMode && recognition) {
        setStatus('🎤 Say something to start', 'idle');
      }
    }, 500);
  </script>
</body>
</html>
