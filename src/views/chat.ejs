<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Music Assistant</title>
    <style>
        body {
            font-family: 'Trebuchet MS', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 20px;
            display: flex;
            flex-direction: column;
            height: 100vh;
            box-sizing: border-box;
            color: #1f2b4a;
            background:
                radial-gradient(circle at 12% 10%, #ffe87a 0 8%, transparent 9%),
                radial-gradient(circle at 88% 12%, #ff9dd5 0 7%, transparent 8%),
                radial-gradient(circle at 10% 84%, #86ffd5 0 8%, transparent 9%),
                radial-gradient(circle at 86% 88%, #8ad4ff 0 9%, transparent 10%),
                linear-gradient(160deg, #fff4d6 0%, #ffe0f0 35%, #ddf8ff 72%, #e4ffef 100%);
        }
        .header {
            text-align: center;
            margin-bottom: 16px;
            position: relative;
            color: #2d2d7a;
            font-weight: 900;
        }
        .chat-container {
            flex: 1;
            background: #ffffffd9;
            border-radius: 20px;
            box-shadow: 0 14px 24px rgba(58, 79, 132, 0.15);
            border: 2px solid #e5e9ff;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            max-width: 860px;
            margin: 0 auto;
            width: 100%;
        }
        .chat-messages {
            flex: 1;
            padding: 20px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 15px;
        }
        .message {
            max-width: 84%;
            padding: 11px 15px;
            border-radius: 16px;
            line-height: 1.5;
            font-size: 0.98rem;
        }
        .message.user {
            align-self: flex-end;
            background: linear-gradient(140deg, #7f5cff, #5f26ce);
            color: white;
            border-bottom-right-radius: 6px;
        }
        .message.ai {
            align-self: flex-start;
            background: linear-gradient(140deg, #fff6a8, #ffe7cf);
            color: #2b2e68;
            border: 1px solid #f1cf78;
            border-bottom-left-radius: 6px;
        }
        .input-area {
            padding: 16px;
            border-top: 2px solid #ebe6ff;
            display: flex;
            gap: 10px;
            background: #fff;
        }
        input[type="text"] {
            flex: 1;
            padding: 12px;
            border: 2px solid #d9d7ff;
            border-radius: 14px;
            outline: none;
            font-size: 16px;
        }
        button {
            padding: 12px 22px;
            background: linear-gradient(140deg, #ff7db8, #ff5f95);
            color: white;
            border: none;
            border-radius: 14px;
            cursor: pointer;
            font-size: 16px;
            font-weight: 800;
            transition: transform 0.2s ease;
        }
        button:hover {
            transform: translateY(-1px);
        }
        button:disabled {
            background: #b9b6cd;
            cursor: not-allowed;
        }
        .back-link {
            position: absolute;
            left: 0;
            top: 50%;
            transform: translateY(-50%);
            text-decoration: none;
            color: #5f26ce;
            font-weight: 800;
        }
        .loading {
            align-self: center;
            color: #5f26ce;
            font-style: italic;
            display: none;
            font-weight: 700;
        }
    </style>
</head>
<body>
    <div class="header">
        <a href="/" class="back-link">← Home</a>
        <h1>AI Music Assistant</h1>
    </div>

    <div class="chat-container">
        <div class="chat-messages" id="chatMessages">
            <div class="message ai">
                Hello <%= user.user_name %>! I'm your AI music theory assistant. How can I help you today?
            </div>
        </div>
        <div class="loading" id="loading">Thinking...</div>
        <div class="input-area">
            <input type="text" id="messageInput" placeholder="Ask about intervals, scales, or chords..." autocomplete="off">
            <button onclick="sendMessage()" id="sendButton">Send</button>
        </div>
    </div>

    <script>
        const messageInput = document.getElementById('messageInput');
        const chatMessages = document.getElementById('chatMessages');
        const sendButton = document.getElementById('sendButton');
        const loading = document.getElementById('loading');

        messageInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') sendMessage();
        });

        async function sendMessage() {
            const text = messageInput.value.trim();
            if (!text) return;

            // Add user message
            appendMessage(text, 'user');
            messageInput.value = '';
            messageInput.disabled = true;
            sendButton.disabled = true;
            loading.style.display = 'block';

            try {
                const response = await fetch('/chat/api/message', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ message: text })
                });

                const data = await response.json();
                
                if (data.error) {
                    appendMessage('Error: ' + data.error, 'ai');
                } else {
                    appendMessage(data.reply, 'ai');
                }
            } catch (error) {
                appendMessage('Sorry, something went wrong. Please try again.', 'ai');
            } finally {
                messageInput.disabled = false;
                sendButton.disabled = false;
                messageInput.focus();
                loading.style.display = 'none';
            }
        }

        function appendMessage(text, sender) {
            const div = document.createElement('div');
            div.className = `message ${sender}`;
            div.textContent = text;
            chatMessages.appendChild(div);
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }
    </script>
</body>
</html>
