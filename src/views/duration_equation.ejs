<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Duration Equation - Music Theory App</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .quiz-section {
            margin-bottom: 40px;
            padding: 20px;
            border: 1px solid #ddd;
            border-radius: 8px;
            background-color: #fff;
        }
        .quiz-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }
        .settings-panel {
            background-color: #f8f9fa;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
        }
        .settings-group {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
        }
        .checkbox-label {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
        }
        .question-text {
            font-size: 1.2em;
            margin-bottom: 20px;
            font-weight: 500;
        }
        .answer-form {
            display: flex;
            gap: 10px;
            align-items: center;
            margin-bottom: 20px;
        }
        .answer-input {
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 4px;
            font-size: 1em;
            width: 100px;
        }
        .result-message {
            padding: 15px;
            border-radius: 8px;
            margin-top: 20px;
            font-weight: bold;
        }
        .result-correct {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }
        .result-wrong {
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }
    </style>
</head>
<body>
    <div class="container">
        <%- include('partials/header', { title: 'Duration Equation', description: 'Calculate note durations and time signatures.' }) %>

        <main>
            <!-- Duration Quiz Section -->
            <div class="quiz-section">
                <div class="quiz-header">
                    <h2>Music Duration Quiz</h2>
                </div>

                <div class="settings-panel">
                    <form action="/duration_equation/duration/generate" method="POST">
                        <div class="settings-group">
                            <label class="checkbox-label">
                                <input type="checkbox" name="hard" <%= duration.settings.hard ? 'checked' : '' %>>
                                Hard Mode
                            </label>
                            <label class="checkbox-label">
                                <input type="checkbox" name="simple" <%= duration.settings.simple ? 'checked' : '' %>>
                                Dotted
                            </label>
                            <label class="checkbox-label">
                                <input type="checkbox" name="double_dotted" <%= duration.settings.double_dotted ? 'checked' : '' %>>
                                Double Dotted
                            </label>
                            <button type="submit" class="btn">Generate New Question</button>
                        </div>
                    </form>
                </div>

                <% if (duration.question) { %>
                    <div class="question-display">
                        <p class="question-text"><%= duration.question %></p>
                        
                        <% if (!duration.submitted) { %>
                            <form action="/duration_equation/duration/check" method="POST" class="answer-form">
                                <input type="text" name="answer" class="answer-input" placeholder="Answer" required autocomplete="off">
                                <button type="submit" class="btn">Check Answer</button>
                            </form>
                        <% } else { %>
                            <div class="result-message <%= duration.isCorrect ? 'result-correct' : 'result-wrong' %>">
                                <% if (duration.isCorrect) { %>
                                    Correct! 🎉
                                <% } else { %>
                                    Incorrect. The answer is <%= duration.correctAnswer %>.
                                <% } %>
                                <p>Your answer: <%= duration.userAnswer %></p>
                            </div>
                            <form action="/duration_equation/duration/generate" method="POST" style="margin-top: 15px;">
                                <input type="hidden" name="hard" value="<%= duration.settings.hard ? 'on' : '' %>">
                                <input type="hidden" name="simple" value="<%= duration.settings.simple ? 'on' : '' %>">
                                <input type="hidden" name="double_dotted" value="<%= duration.settings.double_dotted ? 'on' : '' %>">
                                <button type="submit" class="btn">Next Question</button>
                            </form>
                        <% } %>
                    </div>
                <% } %>
            </div>

            <!-- Time Signature Quiz Section -->
            <div class="quiz-section">
                <div class="quiz-header">
                    <h2>Time Signature Calculation</h2>
                </div>

                <div class="settings-panel">
                    <form action="/duration_equation/time_signature/generate" method="POST">
                        <button type="submit" class="btn">Generate New Question</button>
                    </form>
                </div>

                <% if (timeSignature.question) { %>
                    <div class="question-display">
                        <p class="question-text"><%= timeSignature.question %></p>
                        
                        <% if (!timeSignature.submitted) { %>
                            <form action="/duration_equation/time_signature/check" method="POST" class="answer-form">
                                <input type="text" name="answer" class="answer-input" placeholder="Answer" required autocomplete="off">
                                <button type="submit" class="btn">Check Answer</button>
                            </form>
                        <% } else { %>
                            <div class="result-message <%= timeSignature.isCorrect ? 'result-correct' : 'result-wrong' %>">
                                <% if (timeSignature.isCorrect) { %>
                                    Correct! 🎉
                                <% } else { %>
                                    Incorrect. The answer is <%= timeSignature.correctAnswer %>.
                                <% } %>
                                <p>Your answer: <%= timeSignature.userAnswer %></p>
                            </div>
                            <form action="/duration_equation/time_signature/generate" method="POST" style="margin-top: 15px;">
                                <button type="submit" class="btn">Next Question</button>
                            </form>
                        <% } %>
                    </div>
                <% } %>
            </div>
        </main>
    </div>
    <%- include('partials/ai_chat') %>
</body>
</html>
