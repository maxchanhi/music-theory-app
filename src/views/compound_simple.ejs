<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Compound & Simple Time - Music Theory App</title>
    <!-- Use standard UMD build for browser support -->
    <script src="https://cdn.jsdelivr.net/npm/vexflow@4.2.2/build/vexflow.js"></script>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .option-container {
            display: flex;
            align-items: center;
            margin-bottom: 20px;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 8px;
            cursor: pointer;
            transition: background-color 0.2s;
        }
        .option-container:hover {
            background-color: #f5f5f5;
        }
        .option-container.selected {
            background-color: #e0e0e0;
            border-color: #999;
        }
        .option-radio {
            margin-right: 15px;
            transform: scale(1.5);
        }
        .result-message {
            margin-top: 20px;
            padding: 15px;
            border-radius: 8px;
            text-align: center;
            font-size: 1.2em;
        }
        .result-correct {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }
        .result-wrong {
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }
        .controls {
            margin: 20px 0;
            display: flex;
            gap: 15px;
            align-items: center;
            justify-content: center;
        }
        .lilypond-text {
            font-family: monospace;
            background: #f0f0f0;
            padding: 10px;
            border-radius: 4px;
            margin: 10px 0;
            white-space: pre-wrap;
            display: none; /* Hidden by default, useful for debug */
        }
        .score-display {
            text-align: center;
            margin: 20px 0;
        }
        .vexflow-canvas {
            width: 100%;
            overflow-x: auto;
            display: flex;
            justify-content: center;
            min-height: 120px;
        }
    </style>
</head>
<body>
    <div class="container">
        <%- include('partials/header', { title: 'Compound & Simple Time', description: 'Practice metric modulation between simple and compound time.' }) %>

        <main>
            <div class="card">
                <h2>Identify the Correct Metric Modulation</h2>
                <p>Which option correctly translates between simple and compound time?</p>
                
                <% if (question && vexData) { %>
                    <div class="question-display score-display">
                        <h3>Question</h3>
                        <p>Time Signature: <%= vexData.question.timeSignature %></p>
                        <div id="canvas-question" class="vexflow-canvas"></div>
                        <div class="lilypond-text"><%= vexData.question.notes.join(' ') %></div>
                    </div>

                    <form action="/compound_simple/check" method="POST" id="optionsForm">
                        <div class="options-list">
                            <% vexData.options.forEach((opt, index) => { %>
                                <label class="option-container <%= submitted && index === selectedOption ? 'selected' : '' %>">
                                    <input type="radio" name="optionIndex" value="<%= index %>" class="option-radio" 
                                        <%= submitted ? 'disabled' : '' %> 
                                        <%= submitted && index === selectedOption ? 'checked' : '' %>
                                        required>
                                    <div style="flex-grow: 1;">
                                        <span>Option <%= index + 1 %></span>
                                        <p>Time: <%= opt.timeSignature %></p>
                                        <div id="canvas-option-<%= index %>" class="vexflow-canvas"></div>
                                        <div class="lilypond-text"><%= opt.notes.join(' ') %></div>
                                    </div>
                                </label>
                            <% }); %>
                        </div>
                        
                        <% if (!submitted) { %>
                            <div class="controls">
                                <button type="submit" class="btn">Check Answer</button>
                                <button type="submit" formaction="/compound_simple/generate" class="btn btn-secondary">New Question</button>
                            </div>
                        <% } else { %>
                            <div class="controls">
                                <a href="/compound_simple" class="btn">Next Question</a>
                            </div>
                        <% } %>
                    </form>

                    <% if (submitted) { %>
                        <div class="result-message <%= isCorrect ? 'result-correct' : 'result-wrong' %>">
                            <% if (isCorrect) { %>
                                <strong>Correct!</strong> well done! 🎉
                            <% } else { %>
                                <strong>Incorrect.</strong> The correct answer was Option <%= correctIndex + 1 %>.
                            <% } %>
                        </div>
                    <% } %>
                    
                    <!-- Data for client-side rendering -->
                    <script id="vex-data" type="application/json">
                        <%- JSON.stringify(vexData) %>
                    </script>
                    
                    <script>
                        const { Renderer, Stave, StaveNote, Accidental, Formatter, Tuplet, Beam, Voice, Fraction } = Vex.Flow;
                        
                        function parseLilypondNote(noteStr) {
                            // Format: pitch[accidental]duration[dots]
                            // Examples: g4, a8., fis4, bes2, c'4
                            
                            // More robust regex to capture parts including octaves (') and commas (,)
                            const match = noteStr.match(/^([a-gA-G])(is|es|s|f|flat|sharp)?(\d+)(\.*)(['+,]*)$/);
                            if (!match) {
                                console.warn("Failed to parse note:", noteStr);
                                return null;
                            }
                            
                            const step = match[1].toLowerCase();
                            const acc = match[2];
                            const durationVal = match[3];
                            const dots = match[4];
                            const octaveMod = match[5]; // Capture octave markers
                            
                            // Map LilyPond duration to VexFlow duration
                            let duration = "q";
                            if (durationVal === "1") duration = "w";
                            else if (durationVal === "2") duration = "h";
                            else if (durationVal === "4") duration = "q";
                            else if (durationVal === "8") duration = "8";
                            else if (durationVal === "16") duration = "16";
                            else if (durationVal === "32") duration = "32";
                            
                            if (dots && dots.length > 0) {
                                duration += "d"; // Assume single dot for now
                            }
                            
                            // Map accidental
                            let accidental = null;
                            if (acc === "is" || acc === "s" || acc === "sharp") accidental = "#";
                            else if (acc === "es" || acc === "f" || acc === "flat") accidental = "b";
                            
                            // Calculate octave based on modifiers
                            let octave = 4; // Default C4
                            if (octaveMod) {
                                for (let char of octaveMod) {
                                    if (char === "'") octave++;
                                    if (char === ",") octave--;
                                }
                            }
                            
                            const key = `${step}/${octave}`;
                            
                            const note = new StaveNote({
                                keys: [key],
                                duration: duration,
                                auto_stem: true
                            });
                            
                            if (accidental) {
                                note.addModifier(new Accidental(accidental));
                            }
                            
                            if (dots && dots.length > 0) {
                                note.addDot(0);
                            }
                            
                            return note;
                        }

                        function parseMelodyString(melodyArray) {
                            // melodyArray is array of strings.
                            // Each string can be a single note "g4", multiple notes "g8 a8", or tuplet "\tuplet 3/2 { ... }"
                            
                            let notes = [];
                            let tuplets = [];
                            
                            if (!Array.isArray(melodyArray)) {
                                console.error("melodyArray is not an array:", melodyArray);
                                return { notes: [], tuplets: [] };
                            }

                            melodyArray.forEach(segment => {
                                segment = String(segment).trim();
                                if (!segment) return;
                                
                                if (segment.startsWith("\\tuplet")) {
                                    // Parse tuplet: \tuplet 3/2 { a8 b8 c8 }
                                    const match = segment.match(/\\tuplet\s+(\d+)\/(\d+)\s*\{(.*)\}/);
                                    if (match) {
                                        const numNotes = parseInt(match[1]); // e.g. 3
                                        const notesOccupied = parseInt(match[2]); // e.g. 2
                                        const content = match[3].trim();
                                        
                                        const tupletNoteStrs = content.split(/\s+/);
                                        const tupletNotes = tupletNoteStrs.map(s => parseLilypondNote(s)).filter(n => n);
                                        
                                        if (tupletNotes.length > 0) {
                                            notes.push(...tupletNotes);
                                            tuplets.push(new Tuplet(tupletNotes, {
                                                num_notes: numNotes,
                                                notes_occupied: notesOccupied
                                            }));
                                        }
                                    } else {
                                        console.warn("Failed to parse tuplet:", segment);
                                    }
                                } else {
                                    // Split by space for multiple notes
                                    const noteStrs = segment.split(/\s+/);
                                    noteStrs.forEach(s => {
                                        const note = parseLilypondNote(s);
                                        if (note) notes.push(note);
                                    });
                                }
                            });
                            
                            return { notes, tuplets };
                        }
                        
                        function renderScore(containerId, timeSignature, melodyArray) {
                            const container = document.getElementById(containerId);
                            if (!container) return;
                            container.innerHTML = '';
                            
                            const { notes, tuplets } = parseMelodyString(melodyArray);
                            if (notes.length === 0) return;
                            
                            // Calculate width
                            const width = Math.max(400, notes.length * 40 + 50);
                            const height = 120;
                            
                            const renderer = new Renderer(container, Renderer.Backends.SVG);
                            renderer.resize(width, height);
                            const context = renderer.getContext();
                            
                            const stave = new Stave(10, 10, width - 20);
                            stave.addClef("treble");
                            // timeSignature might be array [num, den] or string "num/den"
                            // If array, convert to string
                            let timeSigStr = timeSignature;
                            if (Array.isArray(timeSignature)) {
                                timeSigStr = timeSignature[0] + "/" + timeSignature[1];
                            }
                            stave.addTimeSignature(timeSigStr);
                            stave.setContext(context).draw();
                            
                            // Beam the notes automatically
                            // Beams require notes to be part of a voice for auto-beaming in newer VexFlow? 
                            // Or utilize Beam.generateBeams
                            const beams = Beam.generateBeams(notes, {
                                groups: [new Fraction(3, 8)] 
                            });
                            
                            // Create a voice matching the time signature
                            const timeParts = timeSigStr.split('/');
                            const voice = new Voice({
                                num_beats: parseInt(timeParts[0]), 
                                beat_value: parseInt(timeParts[1])
                            });
                            voice.setStrict(false); // IMPORTANT: Disable strict timing checks
                            voice.addTickables(notes);

                            // Format notes
                            const formatter = new Formatter();
                            formatter.joinVoices([voice]);
                            
                            // Calculate width dynamically
                            const totalWidth = width - 50;
                            formatter.format([voice], totalWidth);
                            
                            voice.draw(context, stave);
                            
                            beams.forEach(b => b.setContext(context).draw());
                            
                            tuplets.forEach(t => t.setContext(context).draw());
                        }
                        
                        // Initialize
                        try {
                            const dataElement = document.getElementById('vex-data');
                            if (dataElement && dataElement.textContent) {
                                const data = JSON.parse(dataElement.textContent);
                                
                                // Render Question
                                if (data.question) {
                                    renderScore("canvas-question", data.question.timeSignature, data.question.notes);
                                }
                                
                                // Render Options
                                if (data.options) {
                                    data.options.forEach((opt, index) => {
                                        renderScore("canvas-option-" + index, opt.timeSignature, opt.notes);
                                    });
                                }
                            }
                        } catch (e) {
                            console.error("Error rendering scores:", e);
                        }
                    </script>

                <% } else { %>
                    <p>Loading question...</p>
                    <form action="/compound_simple/generate" method="POST">
                        <button type="submit" class="btn">Start Quiz</button>
                    </form>
                <% } %>
            </div>
        </main>
    </div>
    <%- include('partials/ai_chat') %>
</body>
</html>
