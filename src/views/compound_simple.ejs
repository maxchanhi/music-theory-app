<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Compound & Simple Time - Music Theory App</title>
    <!-- Use standard UMD build for browser support -->
    <script src="https://cdn.jsdelivr.net/npm/vexflow@4.2.2/build/cjs/vexflow.js"></script>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .option-container {
            display: flex;
            align-items: flex-start;
            margin-bottom: 20px;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 8px;
            cursor: pointer;
            transition: background-color 0.2s;
        }
        .option-container:hover {
            background-color: #f5f5f5;
        }
        .option-container.selected {
            background-color: #e0e0e0;
            border-color: #999;
        }
        .option-radio {
            margin-right: 15px;
            margin-top: 10px;
            transform: scale(1.5);
            cursor: pointer;
        }
        .result-message {
            margin-top: 20px;
            padding: 15px;
            border-radius: 8px;
            text-align: center;
            font-size: 1.2em;
        }
        .result-correct {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }
        .result-wrong {
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }
        .controls {
            margin: 20px 0;
            display: flex;
            gap: 15px;
            align-items: center;
            justify-content: center;
        }
        .lilypond-text {
            font-family: monospace;
            background: #f0f0f0;
            padding: 10px;
            border-radius: 4px;
            margin: 10px 0;
            white-space: pre-wrap;
            display: none; /* Hidden by default, useful for debug */
        }
        .score-display {
            text-align: center;
            margin: 20px 0;
        }
        .vexflow-canvas {
            width: 100%;
            overflow-x: auto;
            min-height: 200px;
            margin: 5px 0;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .vexflow-canvas svg {
            pointer-events: none; /* Ensure clicks pass through to the label */
        }
    </style>
</head>
<body>
    <div class="container">
        <%- include('partials/header', { title: 'Compound & Simple Time', description: 'Practice metric modulation between simple and compound time.' }) %>

        <main>
            <div class="card">
                <h2>Identify the Correct Metric Modulation</h2>
                <p>Which option correctly translates between simple and compound time?</p>
                
                <% if (question && vexData) { %>
                    <div class="question-display score-display">
                        <h3>Question</h3>
                        <div id="canvas-question" class="vexflow-canvas"></div>
                        <div class="lilypond-text"><%= vexData.question.notes.join(' ') %></div>
                    </div>

                    <form action="/compound_simple/check" method="POST" id="optionsForm">
                        <div class="options-list">
                            <% vexData.options.forEach((opt, index) => { %>
                                <label class="option-container <%= submitted && index === selectedOption ? 'selected' : '' %>">
                                    <input type="radio" name="optionIndex" value="<%= index %>" class="option-radio" 
                                        <%= submitted ? 'disabled' : '' %> 
                                        <%= submitted && index === selectedOption ? 'checked' : '' %>
                                        required>
                                    <div style="flex-grow: 1;">
                                        <span>Option <%= index + 1 %></span>
                                        <div id="canvas-option-<%= index %>" class="vexflow-canvas"></div>
                                        <div class="lilypond-text"><%= opt.notes.join(' ') %></div>
                                    </div>
                                </label>
                            <% }); %>
                        </div>
                        
                        <% if (!submitted) { %>
                            <div class="controls">
                                <button type="submit" class="btn">Check Answer</button>
                                <button type="submit" formaction="/compound_simple/generate" class="btn btn-secondary">New Question</button>
                            </div>
                        <% } else { %>
                            <div class="controls">
                                <a href="/compound_simple" class="btn">Next Question</a>
                            </div>
                        <% } %>
                    </form>

                    <% if (submitted) { %>
                        <div class="result-message <%= isCorrect ? 'result-correct' : 'result-wrong' %>">
                            <% if (isCorrect) { %>
                                <strong>Correct!</strong> well done! 🎉
                            <% } else { %>
                                <strong>Incorrect.</strong> The correct answer was Option <%= correctIndex + 1 %>.
                            <% } %>
                        </div>
                    <% } %>
                    
                    <!-- Data for client-side rendering -->
                    <script id="vex-data" type="application/json">
                        <%- JSON.stringify(vexData) %>
                    </script>
                    
                    <script>
                        (function() {
                            console.log('VexFlow script starting...');

                            // Check if VexFlow is loaded
                            if (typeof Vex === 'undefined' || !Vex.Flow) {
                                console.error('VexFlow library not loaded!');
                                return;
                            }

                            const { Renderer, Stave, StaveNote, Accidental, Formatter, Tuplet, Beam, Voice, Fraction } = Vex.Flow;
                            console.log('VexFlow components loaded:', { Renderer, Stave, StaveNote, Accidental, Formatter, Tuplet, Beam, Voice, Fraction });

                            function parseLilypondNote(noteStr) {
                            console.log('Parsing note:', noteStr);
                            // Format: pitch[accidental]duration[dots]
                            // Examples from compound_simple: e4, f8, g8, c'4
                            // Standard LilyPond: g4, a8., fis4, bes2, c'4

                            // Simplified regex for basic pitch+duration format (e.g., "e4", "f8", "c'4")
                            // Also supports accidentals: "fis4", "bes8", "cis2"
                            const match = noteStr.match(/^([a-gA-G])(is|es|#|b)?(\d+)(\.?)$/);
                            if (!match) {
                                console.warn("Failed to parse note:", noteStr);
                                return null;
                            }

                            const step = match[1].toLowerCase();
                            const acc = match[2];
                            const durationVal = match[3];
                            const dots = match[4];

                            console.log('Note parts:', { step, acc, durationVal, dots });

                            // Map LilyPond duration to VexFlow duration
                            let duration = "q";
                            if (durationVal === "1") duration = "w";
                            else if (durationVal === "2") duration = "h";
                            else if (durationVal === "4") duration = "q";
                            else if (durationVal === "8") duration = "8";
                            else if (durationVal === "16") duration = "16";
                            else if (durationVal === "32") duration = "32";

                            if (dots && dots.length > 0) {
                                duration += "d";
                            }

                            // Map accidental
                            let accidental = null;
                            if (acc === "is" || acc === "#" || acc === "sharp") accidental = "#";
                            else if (acc === "es" || acc === "b" || acc === "flat") accidental = "b";

                            // Default octave
                            let octave = 4;

                            const key = `${step}/${octave}`;
                            console.log('Creating note with key:', key, 'duration:', duration);

                            try {
                                const note = new StaveNote({
                                    keys: [key],
                                    duration: duration,
                                    auto_stem: true
                                });

                                if (accidental) {
                                    note.addModifier(new Accidental(accidental));
                                }

                                if (dots && dots.length > 0) {
                                    note.addDot(0);
                                }

                                console.log('Note created successfully:', note);
                                return note;
                            } catch (e) {
                                console.error('Error creating StaveNote:', e);
                                return null;
                            }
                        }

                        function parseMelodyString(melodyArray) {
                            console.log('Parsing melody array:', melodyArray);
                            // melodyArray is array of strings.
                            // Each string can be:
                            //   - Single note: "e4"
                            //   - Multiple notes: "f8 g8" (space-separated)
                            //   - Tuplet: "\tuplet 3/2 { e8 f8 g8 }"

                            let notes = [];
                            let tuplets = [];

                            if (!Array.isArray(melodyArray)) {
                                console.error("melodyArray is not an array:", melodyArray);
                                return { notes: [], tuplets: [] };
                            }

                            melodyArray.forEach((segment, segIndex) => {
                                console.log(`Processing segment ${segIndex}:`, segment);
                                segment = String(segment).trim();
                                if (!segment) return;

                                if (segment.startsWith("\\tuplet")) {
                                    console.log('Found tuplet:', segment);
                                    // Parse tuplet: \tuplet 3/2 { e8 f8 g8 }
                                    const match = segment.match(/\\tuplet\s+(\d+)\/(\d+)\s*\{(.*)\}/);
                                    if (match) {
                                        const numNotes = parseInt(match[1]);
                                        const notesOccupied = parseInt(match[2]);
                                        const content = match[3].trim();

                                        console.log('Tuplet parsed:', { numNotes, notesOccupied, content });

                                        // Split content by space to get individual notes
                                        const tupletNoteStrs = content.split(/\s+/);
                                        console.log('Tuplet note strings:', tupletNoteStrs);
                                        const tupletNotes = tupletNoteStrs.map(s => parseLilypondNote(s)).filter(n => n);

                                        console.log('Tuplet notes created:', tupletNotes);

                                        if (tupletNotes.length > 0) {
                                            notes.push(...tupletNotes);
                                            try {
                                                const tuplet = new Tuplet(tupletNotes, {
                                                    num_notes: numNotes,
                                                    notes_occupied: notesOccupied
                                                });
                                                console.log('Tuplet created:', tuplet);
                                                tuplets.push(tuplet);
                                            } catch (e) {
                                                console.error('Error creating Tuplet:', e);
                                            }
                                        }
                                    } else {
                                        console.warn("Failed to parse tuplet:", segment);
                                    }
                                } else {
                                    // Split by space for multiple notes (e.g., "f8 g8" -> ["f8", "g8"])
                                    console.log('Processing regular notes:', segment);
                                    const noteStrs = segment.split(/\s+/);
                                    console.log('Note strings:', noteStrs);
                                    noteStrs.forEach(s => {
                                        const note = parseLilypondNote(s);
                                        if (note) {
                                            console.log('Adding note:', note);
                                            notes.push(note);
                                        }
                                    });
                                }
                            });

                            console.log('Final parsed result:', { notes, tuplets });
                            return { notes, tuplets };
                        }
                        
                        function renderScore(containerId, timeSignature, melodyArray) {
                            console.log(`Rendering score in container: ${containerId}, timeSignature: ${timeSignature}, melody:`, melodyArray);

                            const container = document.getElementById(containerId);
                            if (!container) {
                                console.error(`Container not found: ${containerId}`);
                                return;
                            }
                            console.log(`Found container: ${containerId}`, container);

                            container.innerHTML = '';

                            const { notes, tuplets } = parseMelodyString(melodyArray);
                            console.log(`Parsed ${notes.length} notes and ${tuplets.length} tuplets`);

                            if (notes.length === 0) {
                                console.warn('No notes to render');
                                container.innerHTML = '<p style="color: red;">No notes to display</p>';
                                return;
                            }

                            // Calculate width
                            const width = Math.max(400, notes.length * 50 + 50);
                            const height = 200;

                            console.log(`Creating renderer with width: ${width}, height: ${height}`);

                            try {
                                const renderer = new Renderer(container, Renderer.Backends.SVG);
                                renderer.resize(width, height);
                                const context = renderer.getContext();
                                
                                // Set SVG viewBox for proper scaling
                                const svg = container.querySelector('svg');
                                if (svg) {
                                    svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
                                    svg.setAttribute('preserveAspectRatio', 'xMidYMid meet');
                                }
                                
                                console.log('Renderer and context created successfully');

                                const stave = new Stave(10, 50, width - 20);
                                stave.addClef("treble");

                                // timeSignature might be array [num, den] or string "num/den"
                                // If array, convert to string
                                let timeSigStr = timeSignature;
                                if (Array.isArray(timeSignature)) {
                                    timeSigStr = timeSignature[0] + "/" + timeSignature[1];
                                }
                                console.log('Adding time signature:', timeSigStr);
                                stave.addTimeSignature(timeSigStr);
                                stave.setContext(context).draw();
                                console.log('Stave drawn successfully');

                                // Create a voice matching the time signature
                                const timeParts = timeSigStr.split('/');
                                console.log('Time signature parts:', timeParts);
                                const voice = new Voice({
                                    num_beats: parseInt(timeParts[0]),
                                    beat_value: parseInt(timeParts[1])
                                });
                                voice.setStrict(false); // IMPORTANT: Disable strict timing checks
                                console.log('Voice created, adding tickables...');
                                voice.addTickables(notes);
                                console.log('Tickables added to voice');

                                // Generate beams BEFORE formatting
                                console.log('Generating beams...');
                                let beams = [];
                                try {
                                    beams = Beam.generateBeams(notes);
                                    console.log('Beams generated:', beams);
                                } catch (beamErr) {
                                    console.warn('Beam generation failed:', beamErr);
                                }

                                // Format notes
                                console.log('Formatting notes...');
                                const formatter = new Formatter();
                                formatter.joinVoices([voice]);

                                // Calculate width dynamically
                                const totalWidth = width - 50;
                                console.log('Formatting with width:', totalWidth);
                                formatter.format([voice], totalWidth);
                                console.log('Formatting complete');

                                console.log('Drawing voice...');
                                voice.draw(context, stave);
                                console.log('Voice drawn successfully');

                                // Draw beams after voice is drawn
                                console.log('Drawing beams...');
                                beams.forEach((b, i) => {
                                    console.log(`Drawing beam ${i}:`, b);
                                    b.setContext(context).draw();
                                });

                                console.log('Drawing tuplets...');
                                tuplets.forEach((t, i) => {
                                    console.log(`Drawing tuplet ${i}:`, t);
                                    t.setContext(context).draw();
                                });

                                console.log(`Score rendering complete for ${containerId}`);

                            } catch (e) {
                                console.error(`Error rendering score in ${containerId}:`, e);
                                container.innerHTML = `<p style="color: red;">Error rendering: ${e.message}</p>`;
                            }
                        }
                        
                        // Initialize
                        window.addEventListener('DOMContentLoaded', () => {
                            console.log('DOMContentLoaded event fired');
                            try {
                                const dataElement = document.getElementById('vex-data');
                                if (dataElement && dataElement.textContent) {
                                    console.log('Found vex-data element');
                                    const data = JSON.parse(dataElement.textContent);
                                    console.log('Parsed data:', data);
                                    
                                    // Render Question
                                    if (data.question) {
                                        console.log('Rendering question...');
                                        renderScore("canvas-question", data.question.timeSignature, data.question.notes);
                                    }
                                    
                                    // Render Options
                                    if (data.options) {
                                        console.log('Rendering options...');
                                        data.options.forEach((opt, index) => {
                                            console.log(`Rendering option ${index}:`, opt);
                                            renderScore("canvas-option-" + index, opt.timeSignature, opt.notes);
                                        });
                                    }
                                } else {
                                    console.error('vex-data element not found or empty');
                                }
                            } catch (e) {
                                console.error("Error rendering scores:", e);
                            }
                        });
                        })();
                    </script>

                <% } else { %>
                    <p>Loading question...</p>
                    <form action="/compound_simple/generate" method="POST">
                        <button type="submit" class="btn">Start Quiz</button>
                    </form>
                <% } %>
            </div>
        </main>
    </div>
    <%- include('partials/ai_chat') %>
</body>
</html>