<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Compound & Simple Time - Music Theory App</title>
    <!-- Use standard UMD build for browser support -->
    <script src="/scripts/vexflow/vexflow.js"></script>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        /* Modernized Styles for Quiz Options */
        .option-container {
            display: flex;
            align-items: center; /* Center align vertically */
            margin-bottom: 20px;
            padding: 20px; /* Increased padding */
            border: 2px solid transparent; /* Prepare for border transition */
            border-radius: 12px; /* Softer corners */
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
            background-color: white;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05); /* Subtle shadow */
        }
        .option-container:hover {
            background-color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            border-color: #3498db;
        }
        .option-container.selected {
            background-color: #eaf6ff; /* Lighter blue bg */
            border-color: #3498db;
            box-shadow: 0 0 0 4px rgba(52, 152, 219, 0.15); /* Focus ring effect */
        }
        .option-radio {
            margin-right: 20px;
            margin-top: 0; /* Reset margin */
            width: 24px;
            height: 24px;
            accent-color: #3498db; /* Modern browser color support */
            cursor: pointer;
        }
        .result-message {
            margin-top: 30px;
            padding: 20px;
            border-radius: 12px;
            text-align: center;
            font-size: 1.2em;
            font-weight: 600;
            animation: fadeIn 0.5s ease-out;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .result-correct {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
            box-shadow: 0 4px 12px rgba(40, 167, 69, 0.1);
        }
        .result-wrong {
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
            box-shadow: 0 4px 12px rgba(220, 53, 69, 0.1);
        }
        .controls {
            margin: 30px 0;
            display: flex;
            gap: 20px;
            align-items: center;
            justify-content: center;
        }
        .lilypond-text {
            font-family: 'Consolas', 'Monaco', monospace;
            background: #f8f9fa;
            padding: 15px;
            border-radius: 8px;
            margin: 15px 0;
            white-space: pre-wrap;
            display: none; 
            border: 1px solid #e9ecef;
            font-size: 0.9em;
            color: #555;
        }
        .score-display {
            text-align: center;
            margin: 30px 0;
        }
        .vexflow-canvas {
            width: 100%;
            overflow-x: hidden;
            min-height: 200px;
            margin: 10px 0;
            display: flex;
            justify-content: center;
            align-items: center;
            /* Add scrollbar styling if needed */
            scrollbar-width: thin;
            scrollbar-color: #ccc transparent;
        }
        .vexflow-canvas svg {
            pointer-events: none; 
        }
        .option-canvas {
            min-height: 140px;
        }
        .option-canvas svg {
            width: 100% !important;
            height: auto !important;
            display: block;
        }
    </style>
</head>
<body>
    <div class="container">
        <%- include('partials/header', { title: 'Compound & Simple Time', description: 'Practice metric modulation between simple and compound time.' }) %>

        <main>
            <div class="card">
                <h2>Identify the Correct Metric Modulation</h2>
                <p>Which option correctly translates between simple and compound time?</p>
                
                <% if (question && vexData) { %>
                    <div class="question-display score-display">
                        <h3>Question</h3>
                        <div id="canvas-question" class="vexflow-canvas"></div>
                        <div class="lilypond-text"><%= vexData.question.notes.join(' ') %></div>
                    </div>

                    <form action="/compound_simple/check" method="POST" id="optionsForm">
                        <div class="options-list">
                            <% vexData.options.forEach((opt, index) => { %>
                                <label class="option-container <%= submitted && index === selectedOption ? 'selected' : '' %>">
                                    <input type="radio" name="optionIndex" value="<%= index %>" class="option-radio" 
                                        <%= submitted ? 'disabled' : '' %> 
                                        <%= submitted && index === selectedOption ? 'checked' : '' %>
                                        required>
                                    <div style="flex-grow: 1;">
                                        <span>Option <%= index + 1 %></span>
                                        <div id="canvas-option-<%= index %>" class="vexflow-canvas option-canvas"></div>
                                        <div class="lilypond-text"><%= opt.notes.join(' ') %></div>
                                    </div>
                                </label>
                            <% }); %>
                        </div>
                        
                        <% if (!submitted) { %>
                            <div class="controls">
                                <button type="submit" class="btn">Check Answer</button>
                                <button type="submit" formaction="/compound_simple/generate" class="btn btn-secondary">New Question</button>
                            </div>
                        <% } else { %>
                            <div class="controls">
                                <a href="/compound_simple" class="btn">Next Question</a>
                            </div>
                        <% } %>
                    </form>

                    <% if (submitted) { %>
                        <div class="result-message <%= isCorrect ? 'result-correct' : 'result-wrong' %>">
                            <% if (isCorrect) { %>
                                <strong>Correct!</strong> well done! 🎉
                            <% } else { %>
                                <strong>Incorrect.</strong> The correct answer was Option <%= correctIndex + 1 %>.
                            <% } %>
                        </div>
                    <% } %>
                    
                    <!-- Data for client-side rendering -->
                    <script id="vex-data" type="application/json">
                        <%- JSON.stringify(vexData) %>
                    </script>
                    
                    <script>
                        (function() {
                        console.log('VexFlow script starting...');
                        
                        // Check if VexFlow is loaded
                        if (typeof VexFlow === 'undefined') {
                            console.error('VexFlow library not loaded!');
                            return;
                        }
                        
                        const { Renderer, Stave, StaveNote, Accidental, Formatter, Tuplet, Beam, Voice, Fraction, Dot } = VexFlow;
                        console.log('VexFlow components loaded:', { Renderer, Stave, StaveNote, Accidental, Formatter, Tuplet, Beam, Voice, Fraction, Dot });
                        
                        function parseLilypondNote(noteStr) {
                            // Format: pitch[accidental]duration[dots]
                            // Examples: g4, a8., fis4, bes2, c'4
                            
                            // More robust regex to capture parts including octaves (') and commas (,)
                            const match = noteStr.match(/^([a-gA-G])(is|es|s|f|flat|sharp)?(\d+)(\.*)(['+,]*)$/);
                            if (!match) {
                                console.warn("Failed to parse note:", noteStr);
                                return null;
                            }
                            
                            const step = match[1].toLowerCase();
                            const acc = match[2];
                            const durationVal = match[3];
                            const dots = match[4];
                            const octaveMod = match[5]; // Capture octave markers
                            
                            // Map LilyPond duration to VexFlow duration
                            let duration = "q";
                            if (durationVal === "1") duration = "w";
                            else if (durationVal === "2") duration = "h";
                            else if (durationVal === "4") duration = "q";
                            else if (durationVal === "8") duration = "8";
                            else if (durationVal === "16") duration = "16";
                            else if (durationVal === "32") duration = "32";
                            
                            if (dots && dots.length > 0) {
                                duration += "d"; // Assume single dot for now
                            }
                            
                            // Map accidental
                            let accidental = null;
                            if (acc === "is" || acc === "s" || acc === "sharp") accidental = "#";
                            else if (acc === "es" || acc === "f" || acc === "flat") accidental = "b";
                            
                            // Calculate octave based on modifiers
                            let octave = 4; // Default C4
                            if (octaveMod) {
                                for (let char of octaveMod) {
                                    if (char === "'") octave++;
                                    if (char === ",") octave--;
                                }
                            }
                            
                            const key = `${step}/${octave}`;
                            
                            try {
                                const note = new StaveNote({
                                    keys: [key],
                                    duration: duration,
                                    auto_stem: true
                                });
                                
                                if (accidental) {
                                    note.addModifier(new Accidental(accidental));
                                }
                                
                                if (dots && dots.length > 0) {
                                    Dot.buildAndAttach([note], {
                                        all: true
                                    });
                                }
                                
                                return note;
                            } catch (e) {
                                console.error('Error creating StaveNote:', e);
                                return null;
                            }
                        }

                        function parseMelodyString(melodyArray) {
                            // melodyArray is array of strings.
                            // Each string can be a single note "g4", multiple notes "g8 a8", or tuplet "\tuplet 3/2 { ... }"
                            
                            let notes = [];
                            let tuplets = [];
                            
                            if (!Array.isArray(melodyArray)) {
                                console.error("melodyArray is not an array:", melodyArray);
                                return { notes: [], tuplets: [] };
                            }

                            melodyArray.forEach((segment, segIndex) => {
                                segment = String(segment).trim();
                                if (!segment) return;
                                
                                if (segment.startsWith("\\tuplet")) {
                                    // Parse tuplet: \tuplet 3/2 { a8 b8 c8 }
                                    const match = segment.match(/\\tuplet\s+(\d+)\/(\d+)\s*\{(.*)\}/);
                                    if (match) {
                                        const numNotes = parseInt(match[1]); // e.g. 3
                                        const notesOccupied = parseInt(match[2]); // e.g. 2
                                        const content = match[3].trim();
                                        
                                        const tupletNoteStrs = content.split(/\s+/);
                                        const tupletNotes = tupletNoteStrs.map(s => parseLilypondNote(s)).filter(n => n);
                                        
                                        if (tupletNotes.length > 0) {
                                            notes.push(...tupletNotes);
                                            try {
                                                const tuplet = new Tuplet(tupletNotes, {
                                                    num_notes: numNotes,
                                                    notes_occupied: notesOccupied
                                                });
                                                tuplets.push(tuplet);
                                            } catch (e) {
                                                console.error('Error creating Tuplet:', e);
                                            }
                                        }
                                    } else {
                                        console.warn("Failed to parse tuplet:", segment);
                                    }
                                } else {
                                    // Split by space for multiple notes
                                    const noteStrs = segment.split(/\s+/);
                                    noteStrs.forEach(s => {
                                        const note = parseLilypondNote(s);
                                        if (note) {
                                            notes.push(note);
                                        }
                                    });
                                }
                            });
                            
                            return { notes, tuplets };
                        }
                        
                        function renderScore(containerId, timeSignature, melodyArray, fitToCell = false) {
                            console.log(`Rendering score in container: ${containerId}, timeSignature: ${timeSignature}, melody:`, melodyArray);
                            
                            const container = document.getElementById(containerId);
                            if (!container) {
                                console.error(`Container not found: ${containerId}`);
                                return;
                            }
                            
                            container.innerHTML = '';
                            
                            const { notes, tuplets } = parseMelodyString(melodyArray);
                            
                            if (notes.length === 0) {
                                console.warn('No notes to render');
                                container.innerHTML = '<p style="color: red;">No notes to display</p>';
                                return;
                            }
                            
                            const containerWidth = Math.max(320, container.clientWidth || 320);
                            const intrinsicWidth = Math.max(420, notes.length * 52 + 80);
                            const width = fitToCell ? intrinsicWidth : Math.max(containerWidth, intrinsicWidth);
                            const height = 200;
                            
                            try {
                                const renderer = new Renderer(container, Renderer.Backends.SVG);
                                renderer.resize(width, height);
                                const context = renderer.getContext();
                                
                                // Set SVG viewBox for proper scaling
                                const svg = container.querySelector('svg');
                                if (svg) {
                                    svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
                                    svg.setAttribute('preserveAspectRatio', 'xMidYMid meet');
                                    if (fitToCell) {
                                        svg.style.width = '100%';
                                        svg.style.height = 'auto';
                                    }
                                }
                                
                                const stave = new Stave(10, 50, width - 20);
                                stave.addClef("treble");
                                
                                let timeSigStr = timeSignature;
                                if (Array.isArray(timeSignature)) {
                                    timeSigStr = timeSignature[0] + "/" + timeSignature[1];
                                }
                                stave.addTimeSignature(timeSigStr);
                                stave.setContext(context).draw();
                                
                                // Beam the notes automatically
                                let beams = [];
                                try {
                                    // Use VexFlow's getDefaultBeamGroups for the specific time signature
                                    const timeParts = timeSigStr.split('/');
                                    const defaultGroups = Beam.getDefaultBeamGroups(timeSigStr);
                                    
                                    beams = Beam.generateBeams(notes, {
                                        groups: defaultGroups
                                    });
                                } catch (e) {
                                    console.warn("Auto-beaming failed, trying default:", e);
                                    try {
                                        beams = Beam.generateBeams(notes);
                                    } catch (e2) {
                                        console.warn("Default beaming also failed:", e2);
                                    }
                                }
                                
                                // Create a voice matching the time signature
                                const timeParts = timeSigStr.split('/');
                                const voice = new Voice({
                                    numBeats: parseInt(timeParts[0]), 
                                    beatValue: parseInt(timeParts[1])
                                });
                                voice.setStrict(false); // IMPORTANT: Disable strict timing checks
                                voice.addTickables(notes);

                                // Format notes to fit within the stave width
                                const formatter = new Formatter();
                                formatter.joinVoices([voice]);
                                
                                // Calculate available width for notes (stave width - padding - clef/time sig width)
                                // Standard padding and offset
                                const startX = stave.getNoteStartX(); 
                                const endX = stave.getNoteEndX();
                                const availableWidth = endX - startX;
                                
                                formatter.format([voice], availableWidth);
                                
                                voice.draw(context, stave);
                                
                                beams.forEach(b => b.setContext(context).draw());
                                
                                tuplets.forEach(t => t.setContext(context).draw());
                                
                                console.log(`Score rendering complete for ${containerId}`);
                                
                            } catch (e) {
                                console.error(`Error rendering score in ${containerId}:`, e);
                                container.innerHTML = `<p style="color: red;">Error rendering: ${e.message}</p>`;
                            }
                        }
                        
                        // Initialize
                        window.addEventListener('DOMContentLoaded', () => {
                            console.log('DOMContentLoaded event fired');
                            try {
                                const dataElement = document.getElementById('vex-data');
                                if (dataElement && dataElement.textContent) {
                                    const data = JSON.parse(dataElement.textContent);
                                    
                                    // Render Question
                                    if (data.question) {
                                        renderScore("canvas-question", data.question.timeSignature, data.question.notes);
                                    }
                                    
                                    // Render Options
                                    if (data.options) {
                                        data.options.forEach((opt, index) => {
                                            renderScore("canvas-option-" + index, opt.timeSignature, opt.notes, true);
                                        });
                                    }
                                } else {
                                    console.error('vex-data element not found or empty');
                                }
                            } catch (e) {
                                console.error("Error rendering scores:", e);
                            }
                        });
                        })();
                    </script>

                <% } else { %>
                    <p>Loading question...</p>
                    <form action="/compound_simple/generate" method="POST">
                        <button type="submit" class="btn">Start Quiz</button>
                    </form>
                <% } %>
            </div>
        </main>
    </div>
    <%- include('partials/ai_chat') %>
</body>
</html>
