<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 0;
        margin-bottom: 20px;
        border-bottom: 1px solid #eee;
    }
    .page-title {
        margin: 0;
        color: #2c3e50;
        font-size: 2em;
        text-align: left;
    }
    .home-link {
        text-decoration: none;
        color: #3498db;
        font-weight: bold;
        display: flex;
        align-items: center;
        font-size: 1.1em;
    }
    .home-link:hover {
        text-decoration: underline;
    }
    .home-link span {
        margin-right: 5px;
    }
    .page-description {
        text-align: left;
        margin-bottom: 30px;
        color: #666;
        font-size: 1.1em;
        line-height: 1.5;
    }
</style>

<div class="page-header">
    <h1 class="page-title"><%= title %></h1>
    <a href="/" class="home-link"><span>←</span> Back to Home</a>
</div>

<% if (typeof description !== 'undefined' && description) { %>
    <div class="page-description">
        <%= description %>
    </div>
<% } %>
